module TokenDispatch64

import RendererPrimitives

-- A dense lexer/token-kind dispatcher.  The numeric token codes are deliberately
-- contiguous so a future ARM/Thumb lowering can choose a jump table instead of
-- a long comparison chain.
--
-- Action slots: 0 atom, 1 opener, 2 closer, 3 syntax/separator, 4 infix,
-- 5 prefix, 6 control expression, 7 declaration, 8 layout, 9 end of file,
-- 10 unknown.
%export "arm-thumb:token_dispatch_64"
token_dispatch_64 : Float32Buffer -> Int32 -> Float32
token_dispatch_64 values token_kind =
  let action_index : Int32
      action_index =
        case token_kind of
        0 => 0 -- identifier
        1 => 0 -- integer
        2 => 0 -- string
        3 => 0 -- character
        4 => 1 -- left parenthesis
        5 => 2 -- right parenthesis
        6 => 1 -- left bracket
        7 => 2 -- right bracket
        8 => 1 -- left brace
        9 => 2 -- right brace
        10 => 3 -- comma
        11 => 3 -- semicolon
        12 => 3 -- colon
        13 => 3 -- dot
        14 => 4 -- plus
        15 => 4 -- minus
        16 => 4 -- star
        17 => 4 -- slash
        18 => 4 -- percent
        19 => 4 -- equals
        20 => 4 -- less than
        21 => 4 -- greater than
        22 => 4 -- less or equal
        23 => 4 -- greater or equal
        24 => 4 -- equal equal
        25 => 4 -- not equal
        26 => 4 -- ampersand
        27 => 4 -- pipe
        28 => 4 -- caret
        29 => 4 -- logical and
        30 => 4 -- logical or
        31 => 5 -- bang
        32 => 6 -- if
        33 => 6 -- then
        34 => 6 -- else
        35 => 6 -- case
        36 => 6 -- of
        37 => 6 -- let
        38 => 6 -- in
        39 => 6 -- where
        40 => 7 -- data
        41 => 7 -- record
        42 => 7 -- interface
        43 => 7 -- implementation
        44 => 7 -- module
        45 => 7 -- import
        46 => 7 -- public
        47 => 7 -- export
        48 => 7 -- total
        49 => 7 -- partial
        50 => 7 -- covering
        51 => 6 -- do
        52 => 6 -- pure
        53 => 6 -- bind
        54 => 5 -- lambda
        55 => 3 -- arrow
        56 => 3 -- fat arrow
        57 => 7 -- type
        58 => 3 -- question mark
        59 => 0 -- underscore
        60 => 8 -- newline
        61 => 8 -- indent
        62 => 8 -- dedent
        63 => 9 -- end of file
        _ => 10 -- unknown token kind
  in float32_buffer_load values action_index

main : IO ()
main = pure ()
