module GhcLexControl

import RendererPrimitives

-- Mechanically reduced from GHC.Internal.Text.Read.Lex.lexCntrlChar:
-- https://github.com/ghc/ghc/blob/cd653714596108ebf47450202b6748c20bb53799/libraries/ghc-internal/src/GHC/Internal/Text/Read/Lex.hs
--
-- The original parser has already consumed "\\^" and dispatches on the next
-- character. ASCII @ through _ map exactly to control codes 0 through 31;
-- anything else is a parse failure, represented here by sentinel slot 32.
%export "arm-thumb:ghc_lex_control"
ghc_lex_control : Float32Buffer -> Int32 -> Float32
ghc_lex_control values code =
  let decoded : Int32
      decoded =
        case code of
          64 => 0
          65 => 1
          66 => 2
          67 => 3
          68 => 4
          69 => 5
          70 => 6
          71 => 7
          72 => 8
          73 => 9
          74 => 10
          75 => 11
          76 => 12
          77 => 13
          78 => 14
          79 => 15
          80 => 16
          81 => 17
          82 => 18
          83 => 19
          84 => 20
          85 => 21
          86 => 22
          87 => 23
          88 => 24
          89 => 25
          90 => 26
          91 => 27
          92 => 28
          93 => 29
          94 => 30
          95 => 31
          _ => 32
  in float32_buffer_load values decoded

main : IO ()
main = pure ()
